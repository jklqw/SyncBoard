# Copy to .env and replace placeholders before running the stack. Never commit real secrets.

# Core
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://syncboard:syncboard@localhost:5432/syncboard?schema=public

# Redis (pub/sub, rate limits, session revocation)
REDIS_URL=redis://:syncboard@localhost:6379

# JWT / sessions
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# MinIO / S3-compatible object storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=syncboard-media
MINIO_PUBLIC_URL=http://localhost:9000/syncboard-media

# Client
VITE_API_URL=http://localhost:3000
